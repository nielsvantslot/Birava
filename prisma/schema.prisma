generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  email             String             @unique
  username          String             @unique
  passwordHash      String
  avatarUrl         String?
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  drinkEntries      DrinkEntry[]
  drinkSessions     DrinkSession[]
  ownedGroups       Group[]            @relation("GroupOwner")
  groupMemberships  GroupMember[]
  groupBans         GroupBan[]
  receivedGroupInvites GroupInvite[]   @relation("GroupInviteInvitee")
  sentGroupInvites     GroupInvite[]   @relation("GroupInviteInviter")
  follows           Follow[]           @relation("FollowFollower")
  followedBy        Follow[]           @relation("FollowFollowing")
  sessions          Session[]
  cheers            Cheer[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  comments          Comment[]
  notificationPreferences NotificationPreference[]
  clientErrorLogs   ClientErrorLog[]
}

/// Per-category notification preferences — gates whether queueNotifications
/// (lib/notify.ts) sends push for that category; the in-app Notification
/// row is always created regardless. The master PushSubscription on/off is
/// a separate, coarser switch.
///
/// Sparse by design: a category defaults to enabled, so a row only exists
/// once a user has explicitly touched that toggle (see
/// lib/commands/notificationCommands.ts). Extracted from what used to be
/// six Boolean columns directly on User — a settings concern with its own
/// independent change lifecycle, not identity data, sharing a row with the
/// password hash for no benefit.
model NotificationPreference {
  userId  String  @db.Uuid
  /// One of lib/dtos's NOTIFICATION_PREFERENCE_KEYS (e.g. "notifyCheer") —
  /// plain text, not an enum, matching the existing app-level union type
  /// rather than introducing a second parallel representation of it.
  key     String
  enabled Boolean
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  sessionToken String   @unique
  expiresAt    DateTime @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum GroupVisibility {
  PUBLIC
  PRIVATE
}

model Group {
  id           String          @id @default(uuid()) @db.Uuid
  name         String
  inviteCode   String          @unique
  ownerId      String          @db.Uuid
  visibility   GroupVisibility @default(PUBLIC)
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  closedAt     DateTime?       @db.Timestamptz(6)
  owner        User            @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members      GroupMember[]
  bans         GroupBan[]
  invites      GroupInvite[]

  @@index([ownerId])
}

enum GroupMemberRole {
  OWNER
  ADMIN
  MEMBER
}

model GroupMember {
  groupId  String          @db.Uuid
  userId   String          @db.Uuid
  role     GroupMemberRole @default(MEMBER)
  joinedAt DateTime        @default(now()) @db.Timestamptz(6)
  group    Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

/// A kicked member is blocked from rejoining via the group's still-known
/// invite code (checked by joinGroup) until an owner/admin explicitly
/// removes the ban (or re-invites them, once #163 lands).
model GroupBan {
  groupId  String   @db.Uuid
  userId   String   @db.Uuid
  bannedAt DateTime @default(now()) @db.Timestamptz(6)
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

enum GroupInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// An in-app invite to join a crew, sent to a mutual follow. A pending row,
/// not an immediate membership — accepting it goes through the same
/// joinGroup path (and GroupBan check) as entering an invite code by hand.
/// Declining/re-inviting has no cooldown, and declining doesn't notify the
/// inviter — only acceptance does (reusing CREW_JOIN).
model GroupInvite {
  id            String            @id @default(uuid()) @db.Uuid
  groupId       String            @db.Uuid
  invitedUserId String            @db.Uuid
  invitedById   String            @db.Uuid
  status        GroupInviteStatus @default(PENDING)
  createdAt     DateTime          @default(now()) @db.Timestamptz(6)
  group         Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedUser   User              @relation("GroupInviteInvitee", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy     User              @relation("GroupInviteInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([invitedUserId, status])
}

/// Kept in sync with DRINK_TYPES in lib/types.ts — that's the single source
/// of truth for display order/copy; this just enforces the same set at the
/// DB layer instead of relying on app-code validation alone.
enum DrinkType {
  Beer
  Wine
  Cocktail
  Other
}

model DrinkEntry {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  sessionId String        @db.Uuid
  drinkName String?
  drinkType DrinkType     @default(Beer)
  venueId   String?       @db.Uuid
  photoUrl  String?
  /// Tiny base64 blurred placeholder generated at upload time, rendered via
  /// next/image's placeholder="blur" while the real photo streams in.
  photoLqip String?
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   DrinkSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  venue     Venue?        @relation(fields: [venueId], references: [id])

  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([venueId])
}

/// A physical place check-ins happen at — extracted from DrinkEntry's old
/// free-text venue/lat/lng (see lib/venueMatching.ts for how a typed name
/// and/or captured coordinates get resolved to one of these rows, or
/// create a new one). Matching is a heuristic (name and/or rough
/// proximity), not a DB constraint, so there is deliberately no unique
/// index here — two rows can legitimately represent the same real place if
/// the matching heuristic didn't catch it.
///
/// name is nullable: a check-in can carry coordinates with no venue name
/// typed at all (geolocation is captured independently of the venue text
/// field), so a Venue can be coordinates-only until some later visit
/// supplies a name (see resolveVenueId's backfill behavior).
model Venue {
  id        String       @id @default(uuid()) @db.Uuid
  name      String?
  lat       Decimal?     @db.Decimal(9, 6)
  lng       Decimal?     @db.Decimal(9, 6)
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  entries   DrinkEntry[]

  @@index([name])
}

/// A drink session: check-ins auto-grouped by a 4-hour inactivity gap
/// (lib/sessions.ts's SESSION_GAP_MS). Its id is always its anchor (first)
/// check-in's id, set explicitly at creation — never DB-generated — so
/// existing /sessions/[id] links, share images, and Cheer/Comment rows stay
/// valid across merges/splits without a redirect table.
model DrinkSession {
  id        String       @id @db.Uuid
  userId    String       @db.Uuid
  startedAt DateTime     @db.Timestamptz(6)
  endedAt   DateTime     @db.Timestamptz(6)
  name      String?
  /// Cached rendered share-image variants (lib/shareImageCache.ts) — storage
  /// keys/URLs, not the bytes themselves. Null means "not cached, or stale":
  /// every command that changes this session's entries or name nulls both
  /// out, and app/api/sessions/[id]/share-image/route.tsx regenerates and
  /// re-populates them on the next request.
  shareImageOpaqueUrl      String?
  shareImageTransparentUrl String?
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   DrinkEntry[]
  cheers    Cheer[]
  comments  Comment[]

  @@index([userId, endedAt])
}

/// A "cheers" (kudos) on a session.
model Cheer {
  sessionId String       @db.Uuid
  userId    String       @db.Uuid
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  session   DrinkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionId, userId])
}

/// A comment on a session.
model Comment {
  id        String       @id @default(uuid()) @db.Uuid
  sessionId String       @db.Uuid
  userId    String       @db.Uuid
  body      String
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  session   DrinkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model Follow {
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  follower    User     @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

enum NotificationType {
  CHEER
  COMMENT
  FOLLOW
  CREW_JOIN
  CREW_CHECKIN
  ACHIEVEMENT
  SESSION_START
  CREW_INVITE
  SESSION_REMINDER
}

/// An in-app + push notification event. Actor/group display text is frozen
/// at write time (not joined live) so the feed reads correctly even after
/// the actor renames or deletes their account.
model Notification {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @db.Uuid
  type             NotificationType
  actorId          String?          @db.Uuid
  actorUsername    String?
  actorAvatarUrl   String?
  entryId          String?          @db.Uuid
  groupId          String?          @db.Uuid
  groupName        String?
  achievementLabel String?
  readAt           DateTime?
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Client-side error capture — no error-tracking service is wired up, so
/// this is the app's only visibility into what actually breaks in the field
/// (components/client-error-reporter.tsx for window.onerror/unhandledrejection,
/// public/sw.js forwarding its own errors via postMessage since the service
/// worker's global scope has no window to report to directly).
///
/// Deliberately schema-loose: `source` varies ("window.onerror",
/// "unhandledrejection", "sw:error", "sw:unhandledrejection") and each shape
/// carries different extra fields (filename/lineno/colno for a thrown error,
/// nothing extra for a rejection) — `context` holds whatever the reporter
/// sent beyond the common fields rather than growing a column per shape.
///
/// Unauthenticated pages can report too (userId is nullable) — a crash on
/// /login is exactly the kind of thing worth seeing. Pruned by
/// pruneClientErrorLogs (lib/commands/clientErrorLogCommands.ts, run daily
/// via app/api/cron/prune-client-error-logs/route.ts) — unbounded growth
/// isn't acceptable on Neon's free-tier storage.
model ClientErrorLog {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  source    String
  message   String
  stack     String?
  pageUrl   String?
  userAgent String?
  userId    String?  @db.Uuid
  context   Json?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
