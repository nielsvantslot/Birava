{
  "name": "birava",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc -p sw/tsconfig.json",
    "sw:build": "tsx scripts/build-sw.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "budgets:check": "tsx scripts/check-bundle-budgets.ts",
    "migrations:check": "tsx scripts/check-migrations.ts",
    "depcruise": "depcruise app components lib modules middleware.ts instrumentation.ts scripts --config .dependency-cruiser.cjs",
    "version:generate": "tsx scripts/write-version.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "backfill:photos": "tsx scripts/backfill-photo-derivatives.ts",
    "restore:backup": "tsx scripts/restore-backup.ts",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app db",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:test:up": "docker compose --profile test up -d db-test",
    "db:test:down": "docker compose --profile test rm -sf db-test",
    "test:unit": "vitest run --project unit",
    "test:integration": "dotenv -e .env.test -o -- npx prisma migrate deploy && dotenv -e .env.test -o -- vitest run --project integration",
    "test:coverage": "dotenv -e .env.test -o -- vitest run --coverage",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@vercel/blob": "^2.8.1",
    "@vercel/otel": "^2.1.3",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "heic-convert": "^2.1.0",
    "hono": "^4.13.13",
    "lucide-react": "^1.56.0",
    "next": "15.5.28",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.0.4",
    "dependency-cruiser": "^17.4.3",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.4",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "fast-check": "^4.10.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
