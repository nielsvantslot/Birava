DATABASE_URL="postgresql://birava:birava@localhost:5433/birava?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Generate with: docker exec birava-app npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Opt-in only — registers the service worker (public/sw.js) against `next
# dev` instead of unregistering it, so you can test SW behavior locally
# (offline caching, the RSC-revalidate flow) without a full production build
# or a staging deploy. Leave unset for normal day-to-day dev work — it
# reintroduces the stale dev-chunk-caching risk components/service-worker-
# registration.tsx's dev-mode unregister exists to avoid.
NEXT_PUBLIC_FORCE_SW_IN_DEV=""
